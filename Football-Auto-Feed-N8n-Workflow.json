{
  "name": "Football News - Auto Image Feed",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://rsshub.app/telegram/channel/vetland_sports_football1"
      },
      "id": "rss-read",
      "name": "Read VETLAND RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.title + ' ' + $json.content }}",
              "operation": "notContains",
              "value2": "1xBet"
            },
            {
              "value1": "={{ $json.title + ' ' + $json.content }}",
              "operation": "notContains",
              "value2": "Promo Code"
            },
            {
              "value1": "={{ $json.title + ' ' + $json.content }}",
              "operation": "notContains",
              "value2": "Bet on"
            }
          ]
        }
      },
      "id": "filter-promos",
      "name": "Filter Out Betting Promos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "headline",
              "name": "headline",
              "type": "string",
              "value": "={{ $json.title }}"
            },
            {
              "id": "content",
              "name": "content",
              "type": "string",
              "value": "={{ $json.content }}"
            },
            {
              "id": "link",
              "name": "link",
              "type": "string",
              "value": "={{ $json.link }}"
            },
            {
              "id": "image_prompt",
              "name": "image_prompt",
              "type": "string",
              "value": "=Photorealistic football news image for headline: {{ $json.title }}. Real footballer in action, different pose, different kit colour to previous posts, stadium background, natural lighting, no text, no watermark, no betting logos. Content: {{ $json.content }}"
            }
          ]
        }
      },
      "id": "build-prompt",
      "name": "Build Image Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        900,
        300
      ],
      "notes": "Connect this to your image generator next - e.g. OpenAI Images, Replicate, or Stability AI node. Use {{ $json.image_prompt }} as the prompt."
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Read VETLAND RSS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read VETLAND RSS": {
      "main": [
        [
          {
            "node": "Filter Out Betting Promos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Out Betting Promos": {
      "main": [
        [
          {
            "node": "Build Image Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveExecutionProgress": true
  },
  "staticData": null
}